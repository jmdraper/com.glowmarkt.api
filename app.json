  "flow": {
    "triggers": [
      {
        "id": "cloud_gas_new_day_figures",
        "title": {
          "en": "New day's figures"
        },
        "hint": {
          "en": "Fires once for each day of gas, when Glowmarkt receives it, usually a day or more later. If several days arrive at once, it fires once for each, oldest first. The cost is for energy only, without the standing charge."
        },
        "tokens": [
          {
            "name": "date",
            "type": "string",
            "title": {
              "en": "Date"
            },
            "example": "Tue 27 Oct"
          },
          {
            "name": "gas_kwh",
            "type": "number",
            "title": {
              "en": "Gas (kWh)"
            },
            "example": 28.081
          },
          {
            "name": "gas_cost",
            "type": "number",
            "title": {
              "en": "Gas cost (£)"
            },
            "example": 2.22
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=glow_cloud_gas"
          }
        ]
      },
      {
        "id": "cloud_gas_data_late",
        "title": {
          "en": "Data is late"
        },
        "hint": {
          "en": "Glowmarkt's gas data is more than 3 days old. Fires once, then again only after the data has caught up."
        },
        "tokens": [
          {
            "name": "days",
            "type": "number",
            "title": {
              "en": "Days behind"
            },
            "example": 4
