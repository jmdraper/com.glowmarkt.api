{
  "name": {
    "en": "Gas meter (cloud)"
  },
  "class": "sensor",
  "capabilities": [
    "gas_day",
    "gas_day_energy",
    "gas_day_cost",
    "tariff",
    "standing_charge",
    "data_up_to"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "cloud"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "logo": "{{driverAssetsPath}}/images/bright75.png",
        "title": {
          "en": "Login with your Bright App credentials"
        },
        "usernameLabel": {
          "en": "E-mail address"
        },
        "usernamePlaceholder": {
          "en": "john@doe.com"
        },
        "passwordLabel": {
          "en": "Password"
        },
        "passwordPlaceholder": {
          "en": "password"
        }
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_my_devices",
        "prev": "login_credentials"
      }
    },
    {
      "id": "add_my_devices",
      "template": "add_devices"
    }
  ]
}
