{
  "triggers": [
    {
      "id": "tariff_changed",
      "title": {
        "en": "Tariff changed"
      },
      "tokens": [
        {
          "name": "tariff",
          "type": "number",
          "title": {
            "en": "Tariff"
          },
          "example": {
            "en": "45.08p/kWh"
          }
        }
      ]
    },
    {
      "id": "cloud_stopped_reporting",
      "title": {
        "en": "Meter stopped reporting"
      },
      "hint": {
        "en": "Glowmarkt's live power reading hasn't moved, or couldn't be fetched, for longer than the device's stale-after setting."
      },
      "tokens": [
        {
          "name": "minutes",
          "type": "number",
          "title": {
            "en": "Minutes since last reading"
          },
          "example": 6
        }
      ]
    },
    {
      "id": "cloud_resumed_reporting",
      "title": {
        "en": "Meter resumed reporting"
      },
      "tokens": [
        {
          "name": "minutes",
          "type": "number",
          "title": {
            "en": "Minutes without readings"
          },
          "example": 12
        }
      ]
    },
    {
      "id": "cloud_account_attention",
      "title": {
        "en": "Account needs attention"
      },
      "hint": {
        "en": "Fires once when logging in to Glowmarkt has failed for 30 minutes, or Glowmarkt refuses this meter even after logging in again. It fires again only after the account has worked in between."
      },
      "tokens": [
        {
          "name": "reason",
          "type": "string",
          "title": {
            "en": "Reason"
          },
          "example": "login failing"
        }
      ]
    },
    {
      "id": "cloud_started_exporting",
      "title": {
        "en": "Started exporting"
      },
      "hint": {
        "en": "Power has been negative (exporting) for a minute."
      },
      "tokens": [
        {
          "name": "power",
          "type": "number",
          "title": {
            "en": "Power (W)"
          },
          "example": -1250
        }
      ]
    },
    {
      "id": "cloud_stopped_exporting",
      "title": {
        "en": "Stopped exporting"
      },
      "hint": {
        "en": "Power has been zero or positive (importing) for a minute."
      },
      "tokens": [
        {
          "name": "power",
          "type": "number",
          "title": {
            "en": "Power (W)"
          },
          "example": 340
        }
      ]
    },
    {
      "id": "cloud_new_day_figures",
      "title": {
        "en": "New day's figures"
      },
      "hint": {
        "en": "Fires once a day, when Glowmarkt has the meter's own figures for the previous day. The cost includes the day's standing charge, if the app fetched the tariff that day."
      },
      "tokens": [
        {
          "name": "date",
          "type": "string",
          "title": {
            "en": "Date"
          },
          "example": "Tue 27 Oct"
        },
        {
          "name": "electricity_kwh",
          "type": "number",
          "title": {
            "en": "Electricity (kWh)"
          },
          "example": 11.196
        },
        {
          "name": "electricity_cost",
          "type": "number",
          "title": {
            "en": "Electricity cost (£)"
          },
          "example": 2.87
        }
      ]
    }
  ],
  "conditions": [
    {
      "id": "cloud_is_reporting",
      "title": {
        "en": "Meter !{{is|isn't}} reporting"
      }
    },
    {
      "id": "cloud_account_ok",
      "title": {
        "en": "Account !{{is|isn't}} OK"
      },
      "hint": {
        "en": "Not OK from when Account needs attention fires until the account works again."
      }
    },
    {
      "id": "cloud_is_exporting",
      "title": {
        "en": "!{{Is|Isn't}} exporting"
      },
      "hint": {
        "en": "Exporting once power has been negative for a minute, until it has been zero or positive for a minute."
      }
    }
  ]
}
